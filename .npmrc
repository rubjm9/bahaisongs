# Cloudflare Pages runs `npx @cloudflare/next-on-pages@1`, which resolves a
# fresh tree. Latest wrangler wants workers-types@5 while next-on-pages wants
# workers-types@4 — legacy-peer-deps lets that optional peer conflict pass.
# Do NOT add @cloudflare/workers-types / next-on-pages to package.json: their
# globals clash with DOM types and break `next build` ESLint.
legacy-peer-deps=true
