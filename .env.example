# Local: http://localhost:3000 — Production (Cloudflare Pages): https://bahaisongs.org
# Supabase Auth → URL Configuration: Site URL = https://bahaisongs.org
# Redirect URLs must include https://bahaisongs.org/auth/callback and http://localhost:3000/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare R2 — server-only, never expose R2_SECRET_ACCESS_KEY to the client
# See docs/setup/cloudflare-r2.md
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_AUDIO=bahaisongs-audio
R2_BUCKET_IMAGES=bahaisongs-images
# Optional — fallback for Workers AI in local dev without bindings
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# GROQ_API_KEY=
# R2_PUBLIC_CDN_BASE_URL=https://cdn.bahaisongs.org
# Auth: email+password is the primary UI path (Supabase Email provider).
# Local (`supabase start`): [auth.email] enable_signup=true, enable_confirmations=false.
# Production (Supabase Dashboard → Authentication → Providers → Email):
#   - Enable Email provider and sign-ups
#   - Prefer "Confirm email" on in prod so new accounts must verify before password sign-in
#   - Minimum password length should stay ≥ 6 (matches client validation)
# Magic link (OTP) remains available as "sign in without a password".
# Set to true after enabling Google in Supabase (Authentication → Providers → Google)
# and adding OAuth credentials from Google Cloud Console.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-52YQGDNQBS
