{
  "name": "bahaisongs",
  "version": "0.1.0",
  "private": true,
  "description": "BahaiSongs.org — modern web platform for Bahá'í music, lyrics and chords.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/shared/lib/supabase/types.ts",
    "etl:wordpress": "tsx --env-file .env.local scripts/import-wordpress.ts",
    "etl:wordpress:dry": "tsx --env-file .env.local scripts/import-wordpress.ts --dry-run",
    "etl:audio": "tsx --env-file .env.local scripts/migrate-audio-r2.ts",
    "etl:audio:dry": "tsx --env-file .env.local scripts/migrate-audio-r2.ts --dry-run",
    "import:bahaiblog:dry": "tsx scripts/normalize-bahaiblog-data.ts && tsx --env-file .env.local scripts/import-bahaiblog-youtube.ts --dry-run",
    "import:bahaiblog": "tsx scripts/normalize-bahaiblog-data.ts && tsx --env-file .env.local scripts/import-bahaiblog-youtube.ts",
    "import:bahaiblog:normalize": "tsx scripts/normalize-bahaiblog-data.ts",
    "validate:redirects": "tsx scripts/validate-redirects.ts",
    "icons:generate": "tsx scripts/generate-pwa-icons.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@chordkit/dictionary": "^1.0.8",
    "@chordkit/react": "^1.0.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@emotion/cache": "^11.13.5",
    "@emotion/react": "^11.13.5",
    "@emotion/styled": "^11.13.5",
    "@hookform/resolvers": "^3.9.1",
    "@mui/material": "^6.1.10",
    "@mui/material-nextjs": "^6.1.10",
    "@parent-tobias/chordpro-renderer": "^2.1.5",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.2",
    "@tanstack/react-query": "^5.62.7",
    "chordpro-editor": "^0.1.2",
    "framer-motion": "^11.13.5",
    "fuse.js": "^7.3.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.18",
    "next-intl": "^3.26.0",
    "next-themes": "^0.4.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.1",
    "react-player": "^2.16.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@serwist/next": "^9.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^4.3.4",
    "aws4fetch": "^1.0.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.18",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "serwist": "^9.0.0",
    "sharp": "^0.33.5",
    "tsx": "^4.22.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8",
    "xml2js": "^0.6.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
